{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironwood-expeditions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{"pattern": "ironwood.sparkles.dev", "custom_domain": true}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "GameRoom"}, {"name": "WORLD", "class_name": "SharedWorldObject"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}, {"tag":"v2", "new_sqlite_classes":["SharedWorldObject"]}],
  "observability": {"enabled": true}
}
